<Project>
  <!-- Chain to the repository-root props (LangVersion). Without this import MSBuild stops at
       the nearest Directory.Build.props and everything under src/ silently falls back to the
       SDK's per-TFM language default. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Single source of truth for the local/dev version. Release builds override
         via -p:Version=<tag> in .github/workflows/release.yml (SemVer, see CHANGELOG.md). -->
    <Version>1.0.0-rc.1</Version>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Common NuGet package metadata -->
  <PropertyGroup>
    <PackageTags>orm;micro-orm;sql;database;dapper-alternative;aot;nativeaot;source-generator</PackageTags>
    <PackageProjectUrl>https://github.com/extrode/jaunty</PackageProjectUrl>
    <!-- Binaries ship under the ISL-EULA (grant conditioned on an Order); the
         repository's LICENSE.md (ISL-R) covers source inspection only. -->
    <PackageLicenseFile>LICENSE-EULA.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 Syed Beparey</Copyright>
    <RepositoryUrl>https://github.com/extrode/jaunty</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- SourceLink and symbols (GitHub SourceLink ships with the .NET 8 SDK) -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Pack README.md and the EULA into NuGet packages -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE-EULA.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\docs\_assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
