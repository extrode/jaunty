<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ExcludeFromCoverage>true</ExcludeFromCoverage>
  </PropertyGroup>

  <!--<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <DefineConstants>AsyncInterfaces</DefineConstants>
  </PropertyGroup>-->

  <!--<Choose>
    <When Condition="$(DefineConstants.Contains('AsyncInterfaces'))">
      <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.3" />
      </ItemGroup>
    </When>
  </Choose>-->

  <PropertyGroup>
    <PackageId>Beparey.Jaunty.Scaffolding</PackageId>
    <Authors>Syed Beparey</Authors>
    <Description>Database-first entity class scaffolding for Jaunty.</Description>
    <RepositoryUrl>https://github.com/beparey/jaunty</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jaunty\Jaunty.csproj" />
    <ProjectReference Include="..\Jaunty.SourceGenerator\Jaunty.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jaunty.Scaffolding.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
