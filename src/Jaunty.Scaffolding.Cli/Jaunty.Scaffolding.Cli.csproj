<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ExcludeFromCoverage>true</ExcludeFromCoverage>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>

    <!-- .NET Tool configuration. Unconditional: pack evaluates the outer build with an empty
         $(TargetFramework), so a TFM-conditioned PackageId never applies and the package
         silently falls back to the assembly name. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-jaunty</ToolCommandName>
    <PackageId>Extrode.Jaunty.Scaffolding.Cli</PackageId>
    <Authors>Extrode LLC</Authors>
    <Description>CLI tool to scaffold entity classes from database schema for Jaunty.</Description>
    <RepositoryUrl>https://github.com/extrode/jaunty</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Spec 010 T15: ilc-time IL2104/IL3053 from THIRD-PARTY assemblies only, kept visible in the
         publish log but not fatal (src/Directory.Build.props TreatWarningsAsErrors would otherwise
         promote them). Seven offenders measured on the 2026-07-30 clean publish (the spec's list
         of six plus System.Configuration.ConfigurationManager); retire per line as they update:
           Microsoft.Data.SqlClient, MySqlConnector, Microsoft.IdentityModel.Tokens,
           System.Configuration.ConfigurationManager,
           and from the net10 NativeAOT runtime pack itself:
           System.Private.DataContractSerialization, Microsoft.CSharp, System.Linq.Expressions.
         First-party IL diagnostics stay fatal - the IL2057 at SQLiteSchemaReader.cs:65 (T16) must
         NOT be added here. -->
    <WarningsNotAsErrors>IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />

    <!-- Database providers -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" /><!-- pin: GHSA-2m69-gcr7-jv3q; 2.1.x native sqlite is vulnerable; 3.0.3 pulls SourceGear.sqlite3 3.50.4+ -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jaunty.Scaffolding\Jaunty.Scaffolding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jaunty.Scaffolding.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
