<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ExcludeFromCoverage>true</ExcludeFromCoverage>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>

    <!-- .NET Tool configuration. Unconditional: pack evaluates the outer build with an empty
         $(TargetFramework), so a TFM-conditioned PackageId never applies and the package
         silently falls back to the assembly name. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-jaunty</ToolCommandName>
    <PackageId>Extrode.Jaunty.Scaffolding.Cli</PackageId>
    <Authors>Extrode LLC</Authors>
    <Description>CLI tool to scaffold entity classes from database schema for Jaunty.</Description>
    <RepositoryUrl>https://github.com/extrode/jaunty</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Spec 010 T15: ilc-time IL2104/IL3053 from THIRD-PARTY assemblies only, kept visible in the
         publish log but not fatal (src/Directory.Build.props TreatWarningsAsErrors would otherwise
         promote them). Seven offenders measured on the 2026-07-30 clean publish (the spec's list
         of six plus System.Configuration.ConfigurationManager); retire per line as they update:
           Microsoft.Data.SqlClient, MySqlConnector, Microsoft.IdentityModel.Tokens,
           System.Configuration.ConfigurationManager,
           and from the net10 NativeAOT runtime pack itself:
           System.Private.DataContractSerialization, Microsoft.CSharp, System.Linq.Expressions.
         First-party IL diagnostics stay fatal - the IL2057 at SQLiteSchemaReader.cs:65 (T16) must
         NOT be added here. -->
    <WarningsNotAsErrors>IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- A .NET tool is installed with `dotnet tool install`, which runs on a developer desktop or
       a CI agent and nowhere else. SQLitePCLRaw.bundle_e_sqlite3 ships e_sqlite3 built for all 34
       RIDs it knows about, and PackAsTool cannot infer the install target, so rc.2 packed every
       one of them: 83,487,302 bytes compressed, 171.53 MB unpacked, of which ~70 MB was iOS,
       Android, wasm and Mac Catalyst native code that `dotnet tool` can never load.

       Two of the kept identifiers are not native and removing either breaks SQL Server
       scaffolding at run time rather than at build time: `runtimes/win/lib/net8.0/` and
       `runtimes/unix/lib/net8.0/` hold the RID-specific *managed* Microsoft.Data.SqlClient,
       System.Diagnostics.EventLog and System.Runtime.Caching assemblies.

       Verified by JauntyToolPackageRuntimeTests, which packs the real project and asserts both
       halves: every kept RID present, every dropped one absent. -->
  <PropertyGroup>
    <JauntyToolRuntimeIdentifiers>;win;unix;win-x64;win-x86;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;</JauntyToolRuntimeIdentifiers>
  </PropertyGroup>

  <Target Name="TrimToolRuntimeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="!$(JauntyToolRuntimeIdentifiers.Contains(';%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier);'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />

    <!-- Database providers -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" /><!-- pin: GHSA-2m69-gcr7-jv3q; 2.1.x native sqlite is vulnerable; 3.0.3 pulls SourceGear.sqlite3 3.50.4+ -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jaunty.Scaffolding\Jaunty.Scaffolding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jaunty.Scaffolding.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
