<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<DefineConstants>AsyncInterfaces</DefineConstants>
	</PropertyGroup>

	<Choose>
		<When Condition="$(DefineConstants.Contains('AsyncInterfaces'))">
			<ItemGroup>
				<PackageReference Include="Microsoft.Bcl.AsyncInterfaces">
					<Version>10.0.10</Version>
				</PackageReference>
			</ItemGroup>
		</When>
	</Choose>

	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<ProjectReference Include="..\Jaunty\Jaunty.csproj"
		                  SetTargetFramework="TargetFramework=net8.0"
		                  SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\Jaunty.Fluent\Jaunty.Fluent.csproj"
		                  SetTargetFramework="TargetFramework=net8.0"
		                  SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<ProjectReference Include="..\Jaunty\Jaunty.csproj"
		                  SetTargetFramework="TargetFramework=net10.0"
		                  SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\Jaunty.Fluent\Jaunty.Fluent.csproj"
		                  SetTargetFramework="TargetFramework=net10.0"
		                  SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<ProjectReference Include="..\Jaunty\Jaunty.csproj"
		                  SetTargetFramework="TargetFramework=netstandard2.0"
		                  SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\Jaunty.Fluent\Jaunty.Fluent.csproj"
		                  SetTargetFramework="TargetFramework=netstandard2.0"
		                  SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Jaunty.FlatFiles.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Jaunty.FlatFiles.DuckDB</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Jaunty.FlatFiles.DuckDB.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup>
		<PackageId>Beparey.Jaunty.FlatFiles</PackageId>
		<Authors>Syed Beparey</Authors>
		<Description>Flat file abstractions for the Jaunty micro-ORM. Supports CSV, TSV, Parquet, JSON, Excel, Delta Lake, and Iceberg formats with extensible custom format registration.</Description>
		<RepositoryUrl>https://github.com/beparey/jaunty</RepositoryUrl>
		<Nullable>enable</Nullable>
		<ErrorReport>none</ErrorReport>
		<PackageTags>$(PackageTags);flat-files;csv;parquet;json;duckdb</PackageTags>
	</PropertyGroup>

</Project>
