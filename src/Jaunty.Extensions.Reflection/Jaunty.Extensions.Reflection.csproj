<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>Beparey.Jaunty.Extensions.Reflection</PackageId>
    <Version>2026.01.01</Version>
    <Authors>Syed Beparey</Authors>
    <Description>Reflection-based mapping extension for Jaunty. Enables Dictionary, dynamic, and ValueTuple mapping.</Description>
    <RepositoryUrl>https://github.com/beparey/jaunty</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Suppress AOT/trimming warnings - this project uses reflection by design -->
    <NoWarn>$(NoWarn);IL2057;IL2067;IL2070;IL2077;IL2080;IL2090;IL2091;IL2093;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\Jaunty\Jaunty.csproj" SetTargetFramework="TargetFramework=net8.0" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ProjectReference Include="..\Jaunty\Jaunty.csproj" SetTargetFramework="TargetFramework=netstandard2.0" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
