<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Extrode.Jaunty.Extensions.Logging</PackageId>
    <Authors>Extrode LLC</Authors>
    <Description>Microsoft.Extensions.Logging and dependency-injection integration for Jaunty. Optional: the core Extrode.Jaunty package has no dependencies on net8.0 or net10.0.</Description>
    <RepositoryUrl>https://github.com/extrode/jaunty</RepositoryUrl>
  </PropertyGroup>

  <!-- The whole reason this package exists. These two packages ship in the ASP.NET Core shared
       framework, which a class library never gets, so they are real dependencies on every TFM.
       Keeping them here is what lets src/Jaunty declare zero dependencies on net8.0/net10.0.
       See docs/02-architecture/dependencies.md. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\Jaunty\Jaunty.csproj" SetTargetFramework="TargetFramework=net8.0" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Jaunty\Jaunty.csproj" SetTargetFramework="TargetFramework=net10.0" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ProjectReference Include="..\Jaunty\Jaunty.csproj" SetTargetFramework="TargetFramework=netstandard2.0" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jaunty.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The parallel half of Jaunty.Tests; same tests, split out so they can run concurrently. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jaunty.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
