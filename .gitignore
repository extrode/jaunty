# =============================================================================
# NEVER IGNORE (Explicit inclusions)
# =============================================================================

# Keep .gitignore itself
!.gitignore

# Keep README files in ignored folders
!**/README.md

# Keep .gitkeep files (placeholder for empty folders)
!.gitkeep

# Keep configuration files that are safe to share
!appsettings.example.json
!.editorconfig
!.gitattributes
packout/

# Locally built macOS arm64 SQLite.Interop (see tools/native/sqlite-interop-osx-arm64/README.md)
tools/native/sqlite-interop-osx-arm64/artifacts/

# Git worktrees - never tracked
.worktrees/

# The repo's one scratch directory : probes, dumps, screenshots, patches.
# Ignored before the first scratch file exists, not after one is committed.
tmp/
