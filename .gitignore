# =============================================================================
# TEST & COVERAGE
# =============================================================================

# Visual Studio Test Explorer (TestResults folder created by default)
/TestResults/
[Tt]est[Rr]esult*/

# Test result files
TestResult.xml
*.trx
nunit-*.xml
*.VisualState.xml

# Code coverage
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.dcvr
OpenCover/

# Chutzpah
_Chutzpah*

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MSTest
*.e2e

# =============================================================================
# PACKAGES & DEPENDENCIES
# =============================================================================

# NuGet packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Node.js (if used)
node_modules/
bower_components/

# Paket
.paket/paket.exe
paket-files/

# =============================================================================
# WINDOWS SHELL CRUFT
# =============================================================================

# Windows Explorer metadata (never commit these)
desktop.ini
.thumbnail
Thumbs.db
ehthumbs.db

# macOS Finder metadata (never commit these)
.DS_Store

# =============================================================================
# JAUNTY PROJECT-SPECIFIC
# =============================================================================

# Generated documentation (public HTML docs go in dist/)
/docs/html-docs/
/docs/benchmark-artifacts/
/docs/doc-coverage/
/docs/framework-comparison/

# Benchmark artifacts (benchmark code stays, results don't)
/benchmarks/results/

# Distribution artifacts (docs-site is committed as the published doc site)
/dist/*
!/dist/docs-site/

# Bulk/generated test data (tpch.db is 1 GB, TPC-H CSVs are hundreds of MB)
/data/**/*.db
/data/**/*.db-journal
/data/**/*.sqlite
/data/**/*.csv
!data/README.md
# Canonical fixtures the test suite requires (CI checks these out; the
# sqlite Northwind.db is the SOURCE the sqlserver script was generated from)
!/data/sqlite/Northwind.db
!/data/basic.csv

# AOT installation (may contain sensitive workload info)
/.dotnet

# Torture test: external reference repo clones (vendored, not part of Jaunty history)
/torture-test/eshoponweb/
/torture-test/sakila/
/torture-test/pagila/
/torture-test/conduit/

# =============================================================================
# EDITOR AND TOOL STATE
# =============================================================================

# OpenCode (configuration)

# =============================================================================
# USER-SPECIFIC & LOCAL
# =============================================================================

# Local settings (may contain connection strings)
**/appsettings.json
!**/appsettings.example.json

# Local history
.localhistory/

# Backup files
Backup*/
*_wpftmp.csproj
_UpgradeReport_Files/
UpgradeLog*.XML
UpgradeLog*.htm
*.rptproj.bak
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Temp files
*~
*$*
*.log
*.tmp

