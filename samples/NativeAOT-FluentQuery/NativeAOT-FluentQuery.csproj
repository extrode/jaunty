<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!--
  Deliberately does NOT reference Extrode.Jaunty.Extensions.Reflection. Spec 003 (fluent
  NativeAOT-safe metadata) closed the gap that made this impossible: fluent queries
  (not just Query<T>) now resolve source-generated entity metadata reflection-free.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Extrode.Jaunty\Extrode.Jaunty.csproj" />
    <ProjectReference Include="..\..\src\Extrode.Jaunty.Fluent\Extrode.Jaunty.Fluent.csproj" />
    <ProjectReference Include="..\..\src\Extrode.Jaunty.SourceGenerator\Extrode.Jaunty.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" /><!-- pin: GHSA-2m69-gcr7-jv3q; 2.1.x native sqlite is vulnerable; 3.0.3 pulls SourceGear.sqlite3 3.50.4+ -->
  </ItemGroup>

</Project>
