{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Schemas/stryker-config.json",
  "stryker-config": {
    "project": "Extrode.Jaunty.Fluent.csproj",
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "mutate": [
      "**/Expressions/**"
    ],
    "ignore-mutations": ["linq.Append", "linq.Count"],
    "reporters": ["progress", "html", "json"],
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "concurrency": 4
  }
}
