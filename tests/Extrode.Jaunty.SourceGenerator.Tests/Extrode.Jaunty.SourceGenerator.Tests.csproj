<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
		<!-- JAUNTYGEN001/JAUNTYGEN005 are deliberately triggered by Entities/GenDuplicateColumnEntity.cs
		     and Entities/GenGetOnlyEntity.cs to prove the generator reports them; #pragma can't scope
		     this per-file because these diagnostics carry a reconstructed Location (JauntyGenerator.cs's
		     DroppedPropertyInfo.Location.ToLocation()) whose SourceTree is null, so Roslyn's pragma
		     suppression - which looks up pragma state on the diagnostic's own SourceTree - can't see it. -->
		<NoWarn>$(NoWarn);JAUNTYGEN001;JAUNTYGEN005</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" /><!-- pin: GHSA-2m69-gcr7-jv3q; 2.1.x native sqlite is vulnerable; 3.0.3 pulls SourceGear.sqlite3 3.50.4+ -->
		<!-- AUD-R25 (B8-7): GeneratorCachingTests drives JauntyGenerator through a
		     CSharpGeneratorDriver by hand, so it needs the Roslyn API itself. Every other test here
		     observes the generator's output indirectly, by compiling against the mappers it emits
		     for the entities in Entities/. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<ProjectReference Include="..\..\src\Extrode.Jaunty\Extrode.Jaunty.csproj" SetTargetFramework="TargetFramework=net8.0" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<ProjectReference Include="..\..\src\Extrode.Jaunty\Extrode.Jaunty.csproj" SetTargetFramework="TargetFramework=net10.0" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<ItemGroup>
		<!-- Both an analyzer and an ordinary reference: the analyzer role is what generates the
		     mappers the rest of this project's tests compile against, and the reference role is what
		     lets GeneratorCachingTests instantiate JauntyGenerator and drive it directly. -->
		<ProjectReference Include="..\..\src\Extrode.Jaunty.SourceGenerator\Extrode.Jaunty.SourceGenerator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="true"
		                  SetTargetFramework="TargetFramework=netstandard2.0" />
	</ItemGroup>

</Project>
