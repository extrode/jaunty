<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <EnableAnalyzers>false</EnableAnalyzers>
    <CodeAnalysisRuleSet Condition="Exists('None.ruleset')">None.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591;CS8618</NoWarn>
    <DefineConstants>$(DefineConstants);ASYNC_ENUMERABLE_SUPPORT</DefineConstants>
  </PropertyGroup>

  <!-- net472-specific settings (loads netstandard2.0 assembly) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>CS1591;CS8618;CS8632;CS8669</NoWarn>
  </PropertyGroup>

  <!-- Async enumerable support (net8.0 Debug only) -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug' AND '$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);ASYNC_ENUMERABLE_SUPPORT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Integration\ARCHIVED-FOR-DELETION\**" />
    <EmbeddedResource Remove="Integration\ARCHIVED-FOR-DELETION\**" />
    <None Remove="Integration\ARCHIVED-FOR-DELETION\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Database Providers -->
    <!-- Npgsql: 10.x for .NET 8+, 8.x for .NET Framework -->
    <PackageReference Include="Npgsql" Version="10.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Npgsql" Version="8.0.7" Condition="'$(TargetFramework)' == 'net472'" />
    <!-- Microsoft.Data.SqlClient: 6.x for .NET 8+, 5.x for .NET Framework -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- MySql.Data: 9.6 for .NET 8+, 9.1 for .NET Framework -->
    <PackageReference Include="MySql.Data" Version="9.6.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="MySql.Data" Version="9.1.0" Condition="'$(TargetFramework)' == 'net472'" />
    <!-- Microsoft.Data.Sqlite: 10.x for .NET 8+, 8.x for .NET Framework -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.13" Condition="'$(TargetFramework)' == 'net472'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json" Condition="Exists('appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jaunty\Jaunty.csproj" />
    <ProjectReference Include="..\..\src\Jaunty.Extensions.Reflection\Jaunty.Extensions.Reflection.csproj" />
  </ItemGroup>




</Project>
