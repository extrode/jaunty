<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <!-- BenchmarkDotNet -->
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
  </ItemGroup>

  <!-- Competing ORMs -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Dapper.Contrib" Version="2.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.*" />
    <PackageReference Include="RepoDb.Sqlite.Microsoft" Version="1.1.*" />
    <PackageReference Include="RepoDb.SqlServer" Version="1.1.*" />
    <PackageReference Include="RepoDb.PostgreSql" Version="1.1.*" />
    <PackageReference Include="RepoDb.MySql" Version="1.1.*" />
    <PackageReference Include="linq2db" Version="6.*" />
  </ItemGroup>

  <!-- Database providers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.*" />
    <PackageReference Include="Npgsql" Version="9.0.*" />
    <PackageReference Include="MySqlConnector" Version="2.4.*" />
  </ItemGroup>

  <!-- Jaunty -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Jaunty\Jaunty.csproj" />
    <ProjectReference Include="..\..\src\Jaunty.Extensions.Reflection\Jaunty.Extensions.Reflection.csproj" />
    <ProjectReference Include="..\..\src\Jaunty.SourceGenerator\Jaunty.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
